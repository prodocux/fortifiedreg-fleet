# ===========================================================================
# FortifiedReg Fleet - Google Cloud Run Environment Configuration Template
# ===========================================================================

# 1. Google Cloud Project & Region Settings
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
SERVICE_NAME="fortifiedreg-fleet"
ARTIFACT_REGISTRY_REPO="fortifiedreg"
IMAGE_TAG="v0.3.0"

# 2. Runtime Environment Settings (Fail-Closed)
FLEET_ENV="production"
FLEET_INTAKE_ADAPTER="live"
FLEET_PDX_ADAPTER="live"

# 3. Upstream ProDocuX Endpoint (HTTPS required in production)
PRODOCUX_BASE_URL="https://prodocux-live-service.example.com"
# If using internal Cloud Run / VPC Service Mesh cleartext HTTP, specify exact hostname:
# PRODOCUX_TRUSTED_HTTP_HOSTS="prodocux-service"

# 4. Security & Authentication Secrets
# (In Cloud Run, FLEET_JWT_SECRET is automatically mounted from Google Secret Manager)
SECRET_NAME="fleet-jwt-secret"
FLEET_JWT_SECRET="replace-with-secure-random-256-bit-secret-key-at-least-32-chars"

# 5. Cloud Run Scaling & Resource Allocation (Optimized for zero baseline cost)
CPU="1"
MEMORY="1Gi"
MIN_INSTANCES="0"
MAX_INSTANCES="5"
CONCURRENCY="80"
TIMEOUT="300"
