# Environment variables template for FortifiedReg Fleet (v0.3.0)
# DO NOT commit real secrets (.env is excluded by .gitignore and .dockerignore)

FLEET_ENV=production
FLEET_JWT_SECRET=
FLEET_DB_PATH=/app/data/fleet.db
FLEET_ARTIFACTS_DIR=/app/artifacts
FLEET_PDX_ADAPTER=live
FLEET_INTAKE_ADAPTER=live
PORT=8000
