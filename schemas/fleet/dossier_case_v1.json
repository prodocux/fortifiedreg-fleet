{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/fleet/dossier_case_v1.json",
  "title": "DossierCaseV1",
  "type": "object",
  "required": [
    "case_id",
    "tenant_id",
    "product_name",
    "jurisdiction",
    "formula",
    "exposure_scenario",
    "supplier_documents"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "product_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["EU", "TW", "US", "GLOBAL"]
    },
    "formula": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["inci_name", "concentration_pct"],
        "properties": {
          "inci_name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "cas_number": { "type": "string", "pattern": "^[0-9]{2,7}-[0-9]{2}-[0-9]$" },
          "concentration_pct": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
          "function": { "type": "string", "maxLength": 64 },
          "noael_mg_kg_day": { "type": "number", "minimum": 0.0, "maximum": 50000.0 }
        },
        "additionalProperties": false
      }
    },
    "exposure_scenario": {
      "type": "object",
      "required": ["product_type", "daily_applied_amount_g", "retention_factor", "body_weight_kg"],
      "properties": {
        "product_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "daily_applied_amount_g": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1000.0 },
        "retention_factor": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "body_weight_kg": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 300.0 }
      },
      "additionalProperties": false
    },
    "supplier_documents": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["doc_id", "filename", "doc_type", "sha256", "supplier_name", "expiry_date"],
        "properties": {
          "doc_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
          "filename": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-zA-Z0-9_.-]+$" },
          "media_type": { "type": "string", "maxLength": 128 },
          "doc_type": { "type": "string", "enum": ["SDS", "COA", "IFRA_CERT", "GMP_CERT"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "supplier_name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "issue_date": { "type": "string", "format": "date" },
          "expiry_date": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
