{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodocux.dev/schemas/proposed/pdx/workflow_checkpoint_v1.json",
  "title": "PDX Workflow Checkpoint v1 (Proposed G1 Contract)",
  "type": "object",
  "required": [
    "checkpoint_id",
    "run_id",
    "subject_digest",
    "plan_digest",
    "completed_step_ids",
    "pending_step_ids",
    "evidence_digests",
    "status",
    "created_at"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Product-neutral digest of the domain input subject payload"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completed_step_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "pending_step_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidence_digests": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "resumed", "cancelled", "expired"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
